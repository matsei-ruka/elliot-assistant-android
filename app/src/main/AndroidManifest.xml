<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Deliberately restricted CTB assistant surface (Spec 001 §C).
         Only the permissions below may be declared; the upstream
         device-control permissions (camera, SMS, contacts, calendar,
         location, Wi-Fi discovery, media read, activity recognition,
         install packages, write settings, media projection, boot start,
         accessibility) are removed from this fork. -->

    <!-- Voice recognition -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Network communication -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Keep CPU running even when screen is OFF -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Required to detect TTS engines and speech recognizer languages (Android 11+) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name="com.openclaw.assistant.OpenClawApplication"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.OpenClawAssistant"
        tools:targetApi="34">

        <!-- Main Activity -->
        <activity
            android:name="com.openclaw.assistant.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.OpenClawAssistant">
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Settings Activity -->
        <activity
            android:name="com.openclaw.assistant.SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.OpenClawAssistant" />

        <!-- Session List Activity -->
        <activity
            android:name="com.openclaw.assistant.SessionListActivity"
            android:exported="false"
            android:theme="@style/Theme.OpenClawAssistant" />

        <!-- Chat Activity -->
        <activity
            android:name="com.openclaw.assistant.ChatActivity"
            android:exported="false"
            android:theme="@style/Theme.OpenClawAssistant" />

        <!-- WakeHermesClaw multi-backend UI -->
        <activity
            android:name="com.openclaw.assistant.ui.backend.BackendListActivity"
            android:label="@string/backends_title"
            android:exported="false"
            android:theme="@style/Theme.OpenClawAssistant" />
        <activity
            android:name="com.openclaw.assistant.ui.backend.BackendEditorActivity"
            android:exported="false"
            android:theme="@style/Theme.OpenClawAssistant" />
        <!-- MobileBridgeSettingsActivity, BridgeApprovalActivity,
             BridgePairingActivity and SelfCheckActivity are not declared in
             the CTB build: they only served the removed mobile-bridge and
             device-capability surfaces. -->
        <activity
            android:name="com.openclaw.assistant.ui.setup.AgentVoiceSetupActivity"
            android:exported="false"
            android:theme="@style/Theme.OpenClawAssistant" />
        <!-- Deep-link target for WakeHermesClaw pairing QR codes. Any QR scanner on the
             phone (including the stock camera app on modern Android) routes
             agentvoice://setup?... or agentvoice://hermes/setup?... here. -->
        <activity
            android:name="com.openclaw.assistant.ui.setup.HermesImportActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.OpenClawAssistant">
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="agentvoice" android:host="setup" />
                <data android:scheme="agentvoice" android:host="hermes" />
            </intent-filter>
        </activity>

        <!-- Voice Interaction Service (Home button long press) -->
        <service
            android:name="com.openclaw.assistant.service.OpenClawAssistantService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/voice_interaction_service" />
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
                <action android:name="android.intent.action.ASSIST" />
            </intent-filter>
        </service>

        <service
            android:name="com.openclaw.assistant.service.OpenClawAssistantSessionService"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />

        <!-- Recognition Service (Required for VoiceInteraction) -->
        <service
            android:name="com.openclaw.assistant.service.OpenClawAssistantRecognitionService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_RECOGNITION_SERVICE">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
            </intent-filter>
        </service>

        <!-- Session Foreground Service (prevents process freeze during conversation) -->
        <service
            android:name="com.openclaw.assistant.service.SessionForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Hotword Detection Service (Ambient Listening) -->
        <service
            android:name="com.openclaw.assistant.service.HotwordService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- NodeForegroundService, MobileBridgeService, the Accessibility
             Bridge and the Notification Listener are not declared in the CTB
             build: their dataSync / mediaProjection / location foreground
             types, accessibility automation and notification access exceed
             the Spec 001 §C permission baseline. The code remains source
             material only. -->

        <!-- The FileProvider (APK installs), BootReceiver
             (RECEIVE_BOOT_COMPLETED) and InstallResultReceiver
             (REQUEST_INSTALL_PACKAGES) are not declared in the CTB build. -->

        <!-- Media Button Receiver (Bluetooth headset / wired headphone button) -->
        <receiver
            android:name=".receiver.MediaButtonReceiver"
            android:exported="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
